# AgentCare Environment Configuration Example

# OpenAI API Key for AI Clinical Decision Support Agents
OPENAI_API_KEY=your_openai_api_key_here

# Database Connection URL (e.g. SQLite for local dev or PostgreSQL)
DATABASE_URL=sqlite:///./agentcare.db

# App Configuration
PROJECT_NAME="AgentCare"
API_V1_STR="/api/v1"
SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
